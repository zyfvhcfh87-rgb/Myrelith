{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webcut.local/schemas/performance-artifact-v3.json",
  "title": "WebCut performance evidence artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "harnessVersion",
    "capturedAt",
    "metadata",
    "fixture",
    "options",
    "metrics",
    "proposedGates",
    "memoryEvidence",
    "telemetry",
    "warnings",
    "consoleProblems",
    "resources"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "harnessVersion": { "const": "issue-57-v1" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "browser", "chromium"],
      "properties": {
        "host": { "$ref": "#/$defs/host" },
        "browser": { "$ref": "#/$defs/browser" },
        "chromium": { "$ref": "#/$defs/chromium" }
      }
    },
    "fixture": { "$ref": "#/$defs/fixture" },
    "options": { "$ref": "#/$defs/options" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launcher-interactive-ms",
        "editor-first-usable-frame-ms",
        "scrub-input-to-present-ms",
        "frame-render-ms",
        "dropped-frames",
        "audio-underruns",
        "import-readiness-ms",
        "memory-plateau-mib",
        "memory-growth-kib-per-batch",
        "telemetry-overhead-percent",
        "export-real-time-ratio"
      ],
      "properties": {
        "launcher-interactive-ms": { "$ref": "#/$defs/metric" },
        "editor-first-usable-frame-ms": { "$ref": "#/$defs/metric" },
        "scrub-input-to-present-ms": { "$ref": "#/$defs/metric" },
        "frame-render-ms": { "$ref": "#/$defs/metric" },
        "dropped-frames": { "$ref": "#/$defs/metric" },
        "audio-underruns": { "$ref": "#/$defs/metric" },
        "import-readiness-ms": { "$ref": "#/$defs/metric" },
        "memory-plateau-mib": { "$ref": "#/$defs/metric" },
        "memory-growth-kib-per-batch": { "$ref": "#/$defs/metric" },
        "telemetry-overhead-percent": { "$ref": "#/$defs/metric" },
        "export-real-time-ratio": { "$ref": "#/$defs/metric" }
      }
    },
    "proposedGates": {
      "type": "array",
      "items": { "$ref": "#/$defs/proposedGate" }
    },
    "memoryEvidence": { "$ref": "#/$defs/memoryEvidence" },
    "telemetry": { "$ref": "#/$defs/telemetry" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "consoleProblems": { "type": "array", "items": { "type": "string" } },
    "resources": { "$ref": "#/$defs/resources" }
  },
  "$defs": {
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "commit",
        "dirty",
        "dirtyFingerprint",
        "nodeVersion",
        "platform",
        "architecture",
        "osRelease",
        "cpuModel",
        "logicalProcessors",
        "totalMemoryGiB",
        "browserChannel",
        "browserVersion",
        "command"
      ],
      "properties": {
        "branch": { "type": ["string", "null"], "minLength": 1 },
        "commit": { "type": ["string", "null"], "minLength": 1 },
        "dirty": { "type": ["boolean", "null"] },
        "dirtyFingerprint": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "nodeVersion": { "type": ["string", "null"], "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "architecture": { "type": ["string", "null"], "minLength": 1 },
        "osRelease": { "type": ["string", "null"], "minLength": 1 },
        "cpuModel": { "type": ["string", "null"], "minLength": 1 },
        "logicalProcessors": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "totalMemoryGiB": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "browserChannel": { "type": "string", "minLength": 1 },
        "browserVersion": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userAgent",
        "platform",
        "language",
        "logicalProcessors",
        "deviceMemoryGiB",
        "viewportWidth",
        "viewportHeight",
        "devicePixelRatio",
        "crossOriginIsolated",
        "webCodecs",
        "offscreenCanvas"
      ],
      "properties": {
        "userAgent": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "logicalProcessors": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "deviceMemoryGiB": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "viewportWidth": { "type": "integer", "minimum": 1 },
        "viewportHeight": { "type": "integer", "minimum": 1 },
        "devicePixelRatio": { "type": "number", "exclusiveMinimum": 0 },
        "crossOriginIsolated": { "type": "boolean" },
        "webCodecs": { "type": "boolean" },
        "offscreenCanvas": { "type": "boolean" }
      }
    },
    "gpuIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "available" },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "unavailable" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "gpuAcceleration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "mode", "basis"],
          "properties": {
            "status": { "const": "available" },
            "mode": { "enum": ["hardware", "software", "mixed"] },
            "basis": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "unavailable" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "gpuDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendorId",
        "deviceId",
        "subSysId",
        "revision",
        "vendorString",
        "deviceString",
        "driverVendor",
        "driverVersion"
      ],
      "properties": {
        "vendorId": { "type": "integer", "minimum": 0 },
        "deviceId": { "type": "integer", "minimum": 0 },
        "subSysId": { "type": ["integer", "null"], "minimum": 0 },
        "revision": { "type": ["integer", "null"], "minimum": 0 },
        "vendorString": { "type": ["string", "null"], "minLength": 1 },
        "deviceString": { "type": ["string", "null"], "minLength": 1 },
        "driverVendor": { "type": ["string", "null"], "minLength": 1 },
        "driverVersion": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "chromium": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "renderer",
        "vendor",
        "driverVendor",
        "driverVersion",
        "acceleration",
        "devices",
        "featureStatus"
      ],
      "properties": {
        "source": { "const": "cdp:SystemInfo.getInfo" },
        "renderer": { "$ref": "#/$defs/gpuIdentity" },
        "vendor": { "$ref": "#/$defs/gpuIdentity" },
        "driverVendor": { "$ref": "#/$defs/gpuIdentity" },
        "driverVersion": { "$ref": "#/$defs/gpuIdentity" },
        "acceleration": { "$ref": "#/$defs/gpuAcceleration" },
        "devices": {
          "type": "array",
          "items": { "$ref": "#/$defs/gpuDevice" }
        },
        "featureStatus": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "fingerprint",
        "assetCount",
        "assetKinds",
        "representative4kAssetCount",
        "trackCount",
        "videoTrackCount",
        "audioTrackCount",
        "clipCount",
        "transitionCount",
        "textClipCount",
        "durationFrames",
        "durationSeconds",
        "width",
        "height",
        "frameRate"
      ],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "assetCount": { "type": "integer", "minimum": 1 },
        "assetKinds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["video", "audio", "image"],
          "properties": {
            "video": { "type": "integer", "minimum": 0 },
            "audio": { "type": "integer", "minimum": 0 },
            "image": { "type": "integer", "minimum": 0 }
          }
        },
        "representative4kAssetCount": { "type": "integer", "minimum": 0 },
        "trackCount": { "type": "integer", "minimum": 1 },
        "videoTrackCount": { "type": "integer", "minimum": 0 },
        "audioTrackCount": { "type": "integer", "minimum": 0 },
        "clipCount": { "type": "integer", "minimum": 0 },
        "transitionCount": { "type": "integer", "minimum": 0 },
        "textClipCount": { "type": "integer", "minimum": 0 },
        "durationFrames": { "type": "integer", "minimum": 1 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "frameRate": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleCount",
        "playbackRuns",
        "playbackDurationMs",
        "memoryBatches",
        "scrubsPerMemoryBatch",
        "exportFrames",
        "skipExport"
      ],
      "properties": {
        "sampleCount": { "type": "integer", "minimum": 1 },
        "playbackRuns": { "type": "integer", "minimum": 1 },
        "playbackDurationMs": { "type": "integer", "minimum": 1 },
        "memoryBatches": {
          "type": "integer",
          "minimum": 1,
          "description": "Post-warmup scrub batches and requested host Chromium process-memory samples."
        },
        "scrubsPerMemoryBatch": { "type": "integer", "minimum": 1 },
        "exportFrames": { "type": "integer", "minimum": 1 },
        "skipExport": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "minimum",
        "maximum",
        "mean",
        "median",
        "p75",
        "p95",
        "variance",
        "standardDeviation"
      ],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "mean": { "type": "number" },
        "median": { "type": "number" },
        "p75": { "type": "number" },
        "p95": { "type": "number" },
        "variance": { "type": "number", "minimum": 0 },
        "standardDeviation": { "type": "number", "minimum": 0 }
      }
    },
    "metric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "unit", "samples", "summary", "definition"],
          "properties": {
            "status": { "const": "measured" },
            "unit": { "enum": ["ms", "count", "MiB", "KiB/batch", "percent", "ratio"] },
            "samples": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "number" }
            },
            "summary": { "$ref": "#/$defs/summary" },
            "definition": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "unit",
            "samples",
            "summary",
            "definition",
            "reason"
          ],
          "properties": {
            "status": { "const": "unavailable" },
            "unit": { "enum": ["ms", "count", "MiB", "KiB/batch", "percent", "ratio"] },
            "samples": { "type": "array", "maxItems": 0 },
            "summary": { "type": "null" },
            "definition": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "processMemoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "type",
        "cpuTimeSeconds",
        "rssBytes",
        "privateBytes",
        "metricBytes"
      ],
      "properties": {
        "pid": { "type": "integer", "minimum": 1 },
        "type": { "type": "string", "minLength": 1 },
        "cpuTimeSeconds": { "type": "number", "minimum": 0 },
        "rssBytes": { "type": ["integer", "null"], "minimum": 0 },
        "privateBytes": { "type": ["integer", "null"], "minimum": 0 },
        "metricBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "processMemoryBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batchIndex",
        "source",
        "hostSampler",
        "primaryMetric",
        "totalBytes",
        "processes"
      ],
      "properties": {
        "batchIndex": { "type": "integer", "minimum": 1 },
        "source": {
          "const": "cdp:SystemInfo.getProcessInfo+host-os-process"
        },
        "hostSampler": { "type": "string", "minLength": 1 },
        "primaryMetric": { "enum": ["private-bytes", "rss-bytes"] },
        "totalBytes": { "type": "integer", "minimum": 0 },
        "processes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/processMemoryEntry" }
        }
      }
    },
    "memoryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source",
        "scope",
        "platform",
        "hostSampler",
        "primaryMetric",
        "reason",
        "samples"
      ],
      "properties": {
        "status": { "enum": ["measured", "unavailable"] },
        "source": {
          "const": "cdp:SystemInfo.getProcessInfo+host-os-process"
        },
        "scope": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "hostSampler": { "type": ["string", "null"], "minLength": 1 },
        "primaryMetric": {
          "type": ["string", "null"],
          "enum": ["private-bytes", "rss-bytes", null]
        },
        "reason": { "type": ["string", "null"], "minLength": 1 },
        "samples": {
          "type": "array",
          "items": { "$ref": "#/$defs/processMemoryBatch" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "measured" } } },
          "then": {
            "properties": {
              "hostSampler": { "type": "string", "minLength": 1 },
              "primaryMetric": { "enum": ["private-bytes", "rss-bytes"] },
              "reason": { "type": "null" },
              "samples": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "unavailable" } } },
          "then": {
            "properties": {
              "hostSampler": { "type": "null" },
              "primaryMetric": { "type": "null" },
              "reason": { "type": "string", "minLength": 1 },
              "samples": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "retainedDocumentGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimatedBytes",
        "objectCount",
        "arrayCount",
        "propertySlotCount",
        "arraySlotCount",
        "stringCount",
        "stringCodeUnitCount",
        "numberRootCount"
      ],
      "properties": {
        "estimatedBytes": { "type": "integer", "minimum": 0 },
        "objectCount": { "type": "integer", "minimum": 0 },
        "arrayCount": { "type": "integer", "minimum": 0 },
        "propertySlotCount": { "type": "integer", "minimum": 0 },
        "arraySlotCount": { "type": "integer", "minimum": 0 },
        "stringCount": { "type": "integer", "minimum": 0 },
        "stringCodeUnitCount": { "type": "integer", "minimum": 0 },
        "numberRootCount": { "type": "integer", "minimum": 0 }
      }
    },
    "documentMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimator", "assumptions", "authoredDocument", "history", "totals"],
      "properties": {
        "estimator": { "const": "json-retained-graph-v1" },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "authoredDocument": {
          "type": "object",
          "additionalProperties": false,
          "required": ["serializedUtf8Bytes", "retainedGraph"],
          "properties": {
            "serializedUtf8Bytes": { "type": "integer", "minimum": 0 },
            "retainedGraph": { "$ref": "#/$defs/retainedDocumentGraph" }
          }
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pastDepth",
            "futureDepth",
            "snapshotCount",
            "serializedUtf8Bytes",
            "estimatedAdditionalRetainedBytes",
            "estimatedStructuralSharingSavingsBytes"
          ],
          "properties": {
            "pastDepth": { "type": "integer", "minimum": 0 },
            "futureDepth": { "type": "integer", "minimum": 0 },
            "snapshotCount": { "type": "integer", "minimum": 0 },
            "serializedUtf8Bytes": { "type": "integer", "minimum": 0 },
            "estimatedAdditionalRetainedBytes": { "type": "integer", "minimum": 0 },
            "estimatedStructuralSharingSavingsBytes": { "type": "integer", "minimum": 0 }
          }
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["serializedUtf8Bytes", "estimatedRetainedBytes"],
          "properties": {
            "serializedUtf8Bytes": { "type": "integer", "minimum": 0 },
            "estimatedRetainedBytes": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "workerRuntimeTelemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "active", "queues", "caches", "decodedMedia", "derivedCaches", "closes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "active": {
          "type": "object",
          "additionalProperties": false,
          "required": ["videoSources", "videoDecoders", "pendingBitmapCopies", "pendingStaticImageOpens"],
          "properties": {
            "videoSources": { "type": "integer", "minimum": 0 },
            "videoDecoders": { "type": "integer", "minimum": 0 },
            "pendingBitmapCopies": { "type": "integer", "minimum": 0 },
            "pendingStaticImageOpens": { "type": "integer", "minimum": 0 }
          }
        },
        "queues": {
          "type": "object",
          "additionalProperties": false,
          "required": ["renderDepth", "renderMaxDepth", "decodeDepth", "decodeMaxDepth"],
          "properties": {
            "renderDepth": { "type": "integer", "minimum": 0 },
            "renderMaxDepth": { "type": "integer", "minimum": 0 },
            "decodeDepth": { "type": "integer", "minimum": 0 },
            "decodeMaxDepth": { "type": "integer", "minimum": 0 }
          }
        },
        "caches": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hits", "misses"],
          "properties": {
            "hits": { "type": "integer", "minimum": 0 },
            "misses": { "type": "integer", "minimum": 0 }
          }
        },
        "decodedMedia": {
          "type": "object",
          "additionalProperties": false,
          "required": ["retainedStaticImages", "retainedStaticImageBytes"],
          "properties": {
            "retainedStaticImages": { "type": "integer", "minimum": 0 },
            "retainedStaticImageBytes": { "type": "integer", "minimum": 0 }
          }
        },
        "derivedCaches": {
          "type": "object",
          "additionalProperties": false,
          "required": ["streamingFrameBitmaps", "estimatedStreamingFrameBytes", "scratchSurfaceBytes", "transitionSurfaceBytes"],
          "properties": {
            "streamingFrameBitmaps": { "type": "integer", "minimum": 0 },
            "estimatedStreamingFrameBytes": { "type": "integer", "minimum": 0 },
            "scratchSurfaceBytes": { "type": "integer", "minimum": 0 },
            "transitionSurfaceBytes": { "type": "integer", "minimum": 0 }
          }
        },
        "closes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decodedVideoFrames", "streamingBitmaps", "staticImageSources"],
          "properties": {
            "decodedVideoFrames": { "type": "integer", "minimum": 0 },
            "streamingBitmaps": { "type": "integer", "minimum": 0 },
            "staticImageSources": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "audioRuntimeTelemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextTime",
        "activeNodeCount",
        "rms",
        "activeDecoderCount",
        "pendingBufferCount",
        "anchorTime",
        "fromFrame",
        "scheduledThroughTimelineTime",
        "scheduledThroughContextTime"
      ],
      "properties": {
        "contextTime": { "type": "number", "minimum": 0 },
        "activeNodeCount": { "type": "integer", "minimum": 0 },
        "rms": { "type": "number", "minimum": 0 },
        "activeDecoderCount": { "type": "integer", "minimum": 0 },
        "pendingBufferCount": { "type": "integer", "minimum": 0 },
        "anchorTime": { "type": "number", "minimum": 0 },
        "fromFrame": { "type": "integer", "minimum": 0 },
        "scheduledThroughTimelineTime": { "type": "number", "minimum": 0 },
        "scheduledThroughContextTime": { "type": "number", "minimum": 0 }
      }
    },
    "runtimeHealthSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycleIndex", "phase", "worker", "audio"],
      "properties": {
        "cycleIndex": { "type": "integer", "minimum": 1 },
        "phase": { "enum": ["playback", "drained"] },
        "worker": {
          "oneOf": [
            { "$ref": "#/$defs/workerRuntimeTelemetry" },
            { "type": "null" }
          ]
        },
        "audio": {
          "oneOf": [
            { "$ref": "#/$defs/audioRuntimeTelemetry" },
            { "type": "null" }
          ]
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentMemory", "overhead", "healthSamples", "cacheDrain", "longAnimationFrames", "userAgentSpecificMemory"],
      "properties": {
        "documentMemory": { "$ref": "#/$defs/documentMemory" },
        "overhead": {
          "type": "object",
          "additionalProperties": false,
          "required": ["controlDurationsMs", "instrumentedDurationsMs", "overheadPercentSamples"],
          "properties": {
            "controlDurationsMs": { "type": "array", "items": { "type": "number", "minimum": 0 } },
            "instrumentedDurationsMs": { "type": "array", "items": { "type": "number", "minimum": 0 } },
            "overheadPercentSamples": { "type": "array", "items": { "type": "number" } }
          }
        },
        "healthSamples": {
          "type": "array",
          "items": { "$ref": "#/$defs/runtimeHealthSample" }
        },
        "cacheDrain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason", "checkedSamples"],
          "properties": {
            "status": { "enum": ["pass", "fail", "unavailable"] },
            "reason": { "type": ["string", "null"], "minLength": 1 },
            "checkedSamples": { "type": "integer", "minimum": 0 }
          }
        },
        "longAnimationFrames": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason", "entryCount", "overflowed", "durationMs"],
          "properties": {
            "status": { "enum": ["measured", "unavailable"] },
            "reason": { "type": ["string", "null"], "minLength": 1 },
            "entryCount": { "type": "integer", "minimum": 0 },
            "overflowed": { "type": "boolean" },
            "durationMs": { "type": "array", "items": { "type": "number", "minimum": 0 }, "maxItems": 500 }
          }
        },
        "userAgentSpecificMemory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason", "bytes", "breakdownCount"],
          "properties": {
            "status": { "enum": ["measured", "unavailable"] },
            "reason": { "type": ["string", "null"], "minLength": 1 },
            "bytes": { "type": ["number", "null"], "minimum": 0 },
            "breakdownCount": { "type": ["integer", "null"], "minimum": 0 }
          }
        }
      }
    },
    "proposedGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "statistic",
        "operator",
        "threshold",
        "rationale",
        "disposition",
        "evaluation"
      ],
      "properties": {
        "metric": {
          "enum": [
            "launcher-interactive-ms",
            "editor-first-usable-frame-ms",
            "scrub-input-to-present-ms",
            "frame-render-ms",
            "dropped-frames",
            "audio-underruns",
            "import-readiness-ms",
            "memory-plateau-mib",
            "memory-growth-kib-per-batch",
            "telemetry-overhead-percent",
            "export-real-time-ratio"
          ]
        },
        "statistic": { "enum": ["median", "p75", "p95", "maximum"] },
        "operator": { "const": "<=" },
        "threshold": { "type": "number" },
        "rationale": { "type": "string", "minLength": 1 },
        "disposition": { "const": "proposal" },
        "evaluation": { "enum": ["pass", "fail", "unavailable"] }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmarkObjectUrlsCreated",
        "benchmarkObjectUrlsRevoked",
        "importedObjectUrlsRevoked",
        "previewDisposed",
        "transportDisposed",
        "exportDisposed",
        "documentStoreRestored",
        "mediaStoreRestored",
        "transportStoreRestored",
        "projectSessionUnchanged",
        "storesRestored"
      ],
      "properties": {
        "benchmarkObjectUrlsCreated": { "type": "integer", "minimum": 0 },
        "benchmarkObjectUrlsRevoked": { "type": "integer", "minimum": 0 },
        "importedObjectUrlsRevoked": { "type": "integer", "minimum": 0 },
        "previewDisposed": { "type": "boolean" },
        "transportDisposed": { "type": "boolean" },
        "exportDisposed": { "type": "boolean" },
        "documentStoreRestored": { "type": "boolean" },
        "mediaStoreRestored": { "type": "boolean" },
        "transportStoreRestored": { "type": "boolean" },
        "projectSessionUnchanged": { "type": "boolean" },
        "storesRestored": { "type": "boolean" }
      }
    }
  }
}
