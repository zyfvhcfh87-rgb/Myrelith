    "candidates": [
      {
        "id": "honesty-audio",
        "rank": 1,
        "rubric": "everyday-audio",
        "title": "Honesty pass on already-demuxable audio (WAVE PCM, MP3, FLAC, OGG Vorbis)",
        "demand": "Users bringing .wav / .mp3 / .flac / .ogg hit README language that names video/audio generically while Mediabunny already demuxes those containers. WAVE PCM is already a first-party playback fixture.",
