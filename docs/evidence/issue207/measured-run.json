  "decisions": [
    {
      "id": "honesty-audio",
      "recommendation": "bounded-child",
      "reason": "Mediabunny already names WAVE PCM, MP3, FLAC, and OGG Vorbis. The child issue is documentation, fixtures, and Media Pool copy only — no new decoder, README claim, or export pair. Native decode remains a per-host matrix cell.",
      "reopen": [
        "Do not ship a format claim until a child issue adds fixtures plus browser evidence and copy.",
        "Keep import and export independent: WAV delivery (#204) is not an import-support claim."
      ],
      "observations": {
        "named": [
          "pcm-s16",
          "mp3",
          "flac",
          "vorbis"
        ],
        "decoded": [
          "pcm-s16.wav"
        ]
      },
      "childShape": "docs-fixtures-media-pool-copy"
    },
    {
      "id": "mpeg-ts-mov",
      "recommendation": "bounded-child",
      "reason": "QTFF/MOV already names AVC+AAC. MPEG-TS already names AVC+AAC. MPEG-2 video was omitted from MPEG-TS tracks rather than reported. Do not advertise MPEG-TS generally.",
      "reopen": [
        "A child may document MOV/MPEG-TS wrapping of already-named codecs and optionally report omitted TS streams.",
        "A child must not add MPEG-2, remote HLS, or a second demuxer."
      ],
      "observations": {
        "movOk": true,
        "tsOk": true,
        "mpeg2VideoNamed": false,
        "mpeg2VideoPresent": false,
        "mpeg2TrackCodecs": [
          "aac"
        ]
      },
      "childShape": "docs-and-mpegts-omission-diagnostics"
    },
