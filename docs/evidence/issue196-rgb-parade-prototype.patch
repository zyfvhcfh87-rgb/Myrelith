+import { expect, test } from '@playwright/test'
+import { writeFile, readFile } from 'node:fs/promises'
+import { createHash } from 'node:crypto'
+import { arch, cpus, platform, release } from 'node:os'
+import { gradingProject } from './issue-196-grading-fixtures.js'
+
+// Registered before exposing the tab: each sample/analysis/paint p95 <= 8 ms;
+// Program p95 growth <= max(2 ms, 10% of paired scopes-off baseline).
+test('RGB parade stays within its sample, paint, playback and ownership gates', async ({ page, browser }) => {
+  test.setTimeout(90_000)
+  const problems: string[] = []
+  page.on('pageerror', (error) => problems.push(error.message))
+  page.on('console', (message) => { if (['warning', 'error'].includes(message.type())) problems.push(message.text()) })
+  const sourcePaths = ['src/domain/videoScopes.ts', 'src/ui/VideoScopesPanel.tsx', 'src/ui/paintVideoScope.ts', 'src/workers/renderWorker/core.ts', 'src/workers/video-scopes.worker.ts', 'src/workers/video-scopes-webgpu.ts']
+  const hashes = () => Promise.all(sourcePaths.map(async (path) => [path, createHash('sha256').update(await readFile(path)).digest('hex')]))
+  const before = await hashes()
+  await gradingProject(page, 600)
+  const isolated = await page.evaluate(async () => {
+    const domainPath = '/src/domain/videoScopes.ts', uiPath = '/src/ui/paintVideoScope.ts'
+    const { analyzeVideoScopes } = await import(domainPath), { paintVideoScope } = await import(uiPath)
+    const source = new OffscreenCanvas(1280, 720), sourceCtx = source.getContext('2d')!
+    const rgba = new ImageData(1280, 720)
+    for (let i = 0; i < rgba.data.length; i += 4) {
+      rgba.data[i] = i % 251; rgba.data[i + 1] = i * 73 % 253; rgba.data[i + 2] = i * 119 % 255; rgba.data[i + 3] = i % 7 ? 255 : 128
+    }
+    sourceCtx.putImageData(rgba, 0, 0)
+    const sample = new OffscreenCanvas(160, 90), sampleCtx = sample.getContext('2d', { willReadFrequently: true })!
+    const output = document.createElement('canvas'); output.width = 320; output.height = 144
+    const paint = output.getContext('2d', { willReadFrequently: true })!
+    const times = { sampleMs: [] as number[], analysisMs: [] as number[], paintMs: [] as number[] }
+    let bytes = 0
+    try {
+      for (let run = 0; run < 22; run++) {
+        const start = performance.now()
+        sampleCtx.clearRect(0, 0, 160, 90); sampleCtx.drawImage(source, 0, 0, 160, 90)
+        const pixels = sampleCtx.getImageData(0, 0, 160, 90), sampled = performance.now()
+        const analysis = analyzeVideoScopes(pixels.data, 160, 90), analyzed = performance.now()
+        paintVideoScope(paint, 'rgb-parade', analysis)
+        const painted = performance.now()
+        // Include completion of queued Canvas work in the conservative paint measurement.
+        paint.getImageData(0, 0, 320, 144)
+        const completed = performance.now()
+        if (run >= 2) { times.sampleMs.push(sampled - start); times.analysisMs.push(analyzed - sampled); times.paintMs.push(Math.max(painted, completed) - analyzed) }
+        bytes = pixels.data.byteLength + analysis.rgbParade.red.byteLength * 3 + 256 * 2 * 4 + analysis.waveform.density.byteLength + analysis.vectorscope.density.byteLength
+        await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()))
+      }
+    } finally { source.width = source.height = sample.width = sample.height = output.width = output.height = 0 }
+    return { ...times, bytes }
+  })
+  const paired = await page.evaluate(async () => {
+    const previewPath = '/src/app/previewController.ts', transportPath = '/src/app/transportController.ts'
+    const statePath = '/src/state/transportStore.ts', scopesPath = '/src/state/videoScopesStore.ts'
+    const { subscribePreviewRenderDiagnostics, setVideoScopesEnabled } = await import(previewPath)
